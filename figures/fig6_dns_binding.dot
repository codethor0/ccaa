digraph DNSBinding {
  graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.25",
         ranksep="0.38", fontname="DejaVu Sans", fontsize=14];
  node [shape=box, style="rounded", color="black", penwidth=1.1,
        fontname="DejaVu Sans", fontsize=12, margin="0.13,0.09"];
  edge [color="black", penwidth=1.1, arrowsize=0.7,
        fontname="DejaVu Sans", fontsize=10];

  request [label="Logical origin: https://api.example:443\nScope: concrete target in 10.60.0.0/16"];
  first [label="Broker resolution\napi.example -> 10.60.0.2"];
  request -> first;

  subgraph weak {
    weak_check [label="WEAK PATH: hostname-only decision\nAuthorize the name; discard the address"];
    dns_again [label="Client resolves the same name again\napi.example -> 169.254.169.254"];
    wrong [label="Connect to an out-of-scope endpoint\nA6 binding soundness fails", style="rounded,filled", fillcolor="#eeeeee"];
    weak_check -> dns_again -> wrong;
  }
  subgraph bound {
    plan [label="BOUND PATH: exact numeric endpoint\nBind origin + IPv4 + 10.60.0.2:443\ntransport + identity rule + route + lease"];
    gate [label="Revalidate current scope/state/token\nBefore the connection effect"];
    connect [label="Numeric connect(10.60.0.2, 443)\nNo second hostname resolution"];
    app [label="Verify service identity and origin\nFresh authorization before application data"];
    plan -> gate -> connect -> app;
  }
  first -> weak_check [style=dashed, label="loses address"];
  first -> plan [label="preserves address"];
  { rank=same; weak_check; plan; }
  { rank=same; dns_again; gate; }
  { rank=same; wrong; connect; }
}
