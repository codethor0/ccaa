digraph G {
  graph [bgcolor="white", pad="0.06", fontname="Helvetica"];
  node [shape=plain, fontname="Helvetica", fontsize=10.5];

  timeline [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#333333">
      <TR><TD COLSPAN="2" BGCOLOR="#E8E8E8"><B>OPENAI / HUGGING FACE INCIDENT TIMELINE</B></TD></TR>
      <TR><TD WIDTH="85"><B>DATE</B></TD><TD WIDTH="430"><B>REPORTED EVENT</B></TD></TR>
      <TR><TD>May 12</TD><TD ALIGN="LEFT">First Artifactory message-board entry</TD></TR>
      <TR><TD>May 26</TD><TD ALIGN="LEFT">Unintended internet via server-side request</TD></TR>
      <TR><TD>Jun 26</TD><TD ALIGN="LEFT">Artifactory privilege escalation</TD></TR>
