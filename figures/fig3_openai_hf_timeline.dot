      <TR><TD>Jul 13</TD><TD ALIGN="LEFT">Artifactory signing key compromised</TD></TR>
      <TR><TD>Jul 19</TD><TD ALIGN="LEFT">OpenAI alert + internal cluster-admin activity</TD></TR>
      <TR><TD COLSPAN="2" BGCOLOR="#F2F2F2" ALIGN="LEFT"><B>CONTRIBUTING CONDITIONS:</B> hard or sometimes unsolved tasks; reduced safeguards; no intended inter-agent channel</TD></TR>
    </TABLE>>];
